PUBLISHING.md

# Pipeline raw fetch artifacts (never committed; may contain large/interim data)
pipeline/raw/

# The canonical build outputs ARE committed (source of truth), despite the
# generic build/ rule above which targets Python build directories.
!data/build/
!data/build/**

# Package build outputs (generated by each package's build; not committed).
packages/*/dist/
packages/*/build/
packages/*/*.egg-info/
packages/*/package-lock.json
packages/**/__pycache__/