PUBLISHING.md

# Pipeline raw fetch artifacts (never committed; may contain large/interim data)
pipeline/raw/

# The canonical build outputs ARE committed (source of truth), despite the
# generic build/ rule above which targets Python build directories.
!data/build/
!data/build/**

# Package build outputs (generated by each package's build; not committed).
packages/*/dist/
packages/*/build/
packages/*/*.egg-info/
packages/*/package-lock.json
packages/**/__pycache__/

# Generated package DATA (regenerate with: python -m pipeline.build --emit-packages).
# The committed source of truth is data/build/ + data/REPORT.md.
packages/node-core/data/
packages/node-geo/data/
packages/py-core/indian_pincode/data/
packages/py-geo/indian_pincode_geo/data/
# Vite fixture build artifacts
tests/vite-fixture/node_modules/
tests/vite-fixture/dist/
tests/vite-fixture/package-lock.json
